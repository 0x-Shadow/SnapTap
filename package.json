{
  "name": "snaptap",
  "version": "2.1.1",
  "description": "Lightweight floating screenshot tool for Windows. Capture your screen with Alt+S, copy to clipboard instantly, and browse your gallery with Alt+G.",
  "main": "main.js",
  "author": "0x-Shadow",
  "license": "MIT",
  "homepage": "https://github.com/0x-Shadow/SnapTap",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x-Shadow/SnapTap.git"
  },
  "bugs": {
    "url": "https://github.com/0x-Shadow/SnapTap/issues"
  },
  "keywords": [
    "screenshot",
    "screen-capture",
    "electron",
    "windows",
    "clipboard",
    "snipping",
    "productivity"
  ],
  "files": [
    "main.js",
    "preload.js",
    "renderer/**/*",
    "assets/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.snaptap.app",
    "productName": "SnapTap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SnapTap",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "SnapTap-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
